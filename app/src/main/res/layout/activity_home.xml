<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card"
        android:gravity="start">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信息APP"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="1dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发现精彩内容"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="1dp"
            android:padding="1dp"/>

    </LinearLayout>

    <!-- 今日推荐模块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card"
        android:padding="16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="26dp"
                android:src="@drawable/knowledge"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日推荐"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="探索最新的信息资讯，获取有价值的知识内容，让生活更加充实精彩。"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonViewMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即查看"
            android:textColor="#FFFFFF"
            android:background="#007AFF"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 四个功能按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <Button
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="资讯"
            android:textColor="#000000"
            android:gravity="center"
            android:background="@drawable/card"
            android:drawableTop="@mipmap/zx"
            android:drawablePadding="8dp"/>
        <Button
            android:id="@+id/btnKnowledge"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="知识"
            android:textColor="#000000"
            android:gravity="center"
            android:background="@drawable/card"
            android:drawableTop="@mipmap/zx"
            android:drawablePadding="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginHorizontal="16dp">
        <Button
            android:id="@+id/btnTrend"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="趋势"
            android:textColor="#000000"
            android:gravity="center"
            android:background="@drawable/card"
            android:drawableTop="@mipmap/zx"
            android:drawablePadding="8dp"/>
        <Button
            android:id="@+id/btnCommunity"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="社区"
            android:textColor="#000000"
            android:gravity="center"
            android:background="@drawable/card"
            android:drawableTop="@mipmap/zx"
            android:drawablePadding="8dp"/>
    </LinearLayout>
    
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- 通用底部导航栏 -->
    <include layout="@layout/bottom_navigation" />

</LinearLayout>














