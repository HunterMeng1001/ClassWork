<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card"
        android:gravity="start">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信息APP"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="1dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发现精彩内容"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="1dp"
            android:padding="1dp"/>

    </LinearLayout>

    <!-- 今日推荐模块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card"
        android:padding="16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="26dp"
                android:src="@drawable/knowledge"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日推荐"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="探索最新的信息资讯，获取有价值的知识内容，让生活更加充实精彩。"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonViewMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即查看"
            android:textColor="#FFFFFF"
            android:background="#007AFF"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 四个功能按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="16dp">
        
        <!-- 第一行按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <!-- 资讯按钮 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <Button
                    android:id="@+id/btnNews"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="资讯"
                    android:textColor="#007AFF"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:drawableTop="@mipmap/zx"
                    android:drawablePadding="12dp"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>
            
            <!-- 知识按钮 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <Button
                    android:id="@+id/btnKnowledge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="知识"
                    android:textColor="#007AFF"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:drawableTop="@mipmap/zx"
                    android:drawablePadding="12dp"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        <!-- 第二行按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <!-- 趋势按钮 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <Button
                    android:id="@+id/btnTrend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="趋势"
                    android:textColor="#007AFF"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:drawableTop="@mipmap/zx"
                    android:drawablePadding="12dp"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>
            
            <!-- 社区按钮 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <Button
                    android:id="@+id/btnCommunity"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="社区"
                    android:textColor="#007AFF"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:drawableTop="@mipmap/zx"
                    android:drawablePadding="12dp"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
    
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>














