<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    
    <!-- 主要内容区域 -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 用户信息头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#007AFF"
            android:orientation="vertical"
            android:padding="24dp">
            
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent" >
                <!-- 圆形头像 -->
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:background="@drawable/circle_background"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="20dp"
                    android:layout_marginLeft="10dp"
                    android:contentDescription="用户头像"/>
                    
                <!-- 用户名和欢迎语，移到头像右侧 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toRightOf="@id/avatar"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="36dp">
                    
                    <TextView
                        android:id="@+id/userName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用户名"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/userIntro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="欢迎来到信息App"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- 功能列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp"
            android:elevation="4dp">
            
            <Button
                android:id="@+id/btnPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="个人信息"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_menu_myplaces"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />
                
            <Button
                android:id="@+id/btnMyCollections"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="我的收藏"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/btn_star_big_on"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />
                
            <Button
                android:id="@+id/btnBrowseHistory"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="浏览历史"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_menu_recent_history"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- 设置区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:elevation="4dp">
            
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="设置"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_menu_preferences"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />
                
            <Button
                android:id="@+id/btnAboutUs"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="关于我们"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_menu_info_details"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginLeft="16dp" />
                
            <Button
                android:id="@+id/btnFeedback"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="意见反馈"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_menu_send"
                android:drawableRight="@drawable/small_right_arrow"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

    </LinearLayout>
    


</RelativeLayout>